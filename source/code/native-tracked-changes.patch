+std::size_t
+RrMultiUserScheduler::ApplyDlSelectionPolicy(AcIndex primaryAc,
+                                             const std::vector<uint8_t>& tids)
+{
+    auto& stationList = m_staListDl[primaryAc];
+    m_selectedRus.clear();
+    m_hasRuAction = false;
+    if (m_dlSelectionPolicy == 0 || stationList.empty())
+    {
+        return m_nStations;
+    }
+    const auto decisionStart = std::chrono::steady_clock::now();
+
+    std::vector<Q1RuStationState> states;
+    states.reserve(std::min<std::size_t>(9, stationList.size()));
+    for (const auto& station : stationList)
+    {
+        if (states.size() == 9)
+        {
+            break;
+        }
+        Q1RuStationState state;
+        state.aid = station.aid;
+        Ptr<WifiMpdu> firstMpdu;
+        for (uint8_t tid : tids)
+        {
+            auto qosTxop = m_apMac->GetQosTxop(QosUtilsMapTidToAc(tid));
+            auto queue = qosTxop->GetWifiMacQueue();
+            const auto queueId = MakeWifiUnicastQueueId(WIFI_QOSDATA_QUEUE, station.address, tid);
+            state.queuePackets += queue->GetNPackets(queueId);
+            state.queueBytes += queue->GetNBytes(queueId);
+            if (firstMpdu || !m_apMac->GetBaAgreementEstablishedAsOriginator(station.address, tid))
+            {
+                continue;
+            }
+            auto item = qosTxop->PeekNextMpdu(m_linkId, tid, station.address);
+            if (item)
+            {
+                state.maxAmpduBytes = GetHeFem(m_linkId)->GetMpduAggregator()->GetMaxAmpduSize(
+                    station.address, tid, WIFI_MOD_CLASS_HE);
+            }
+            const auto prefixLimit = std::min<std::size_t>(
+                m_dlSelectionPolicy == 2 ? Q1RuOptimizer::MAX_PREFIX
+                                         : Q1RuOptimizer::MODEL_PREFIX,
+                qosTxop->GetBaBufferSize(station.address, tid));
+            while (item && state.queue.size() < prefixLimit)
+            {
+                if (!firstMpdu)
+                {
+                    firstMpdu = item;
+                }
+                state.queue.push_back({item->GetPacket()->GetSize(),
+                                       item->GetSize(),
+                                       std::max(0.0,
+                                                (Simulator::Now() - item->GetTimestamp())
+                                                    .ToDouble(Time::MS))});
+                item = qosTxop->PeekNextMpdu(m_linkId, tid, station.address, item);
+            }
+        }
+        if (firstMpdu)
+        {
+            auto txVector =
+                GetWifiRemoteStationManager(m_linkId)->GetDataTxVector(firstMpdu->GetHeader(),
+                                                                        m_allowedWidth);
+            state.mcs = std::min<uint8_t>(11, txVector.GetMode().GetMcsValue());
+            state.nss = txVector.GetNss();
+        }
+        states.push_back(std::move(state));
+    }
+
+    std::map<uint16_t, double> scores;
+    if (m_dlSelectionPolicy == 1)
+    {
+        for (const auto& state : states)
+        {
+            scores[state.aid] = state.queueBytes;
+        }
+        stationList.sort([&scores](const MasterInfo& lhs, const MasterInfo& rhs) {
+            const auto lhsScore = scores.contains(lhs.aid) ? scores.at(lhs.aid) : 0.0;
+            const auto rhsScore = scores.contains(rhs.aid) ? scores.at(rhs.aid) : 0.0;
+            return lhsScore > rhsScore;
+        });
+        m_decisionLatenciesUs.push_back(
+            std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() -
+                                                       decisionStart)
+                .count());
+        return m_nStations;
+    }
+
+    NS_ABORT_MSG_IF(m_allowedWidth != MHz_u{20},
+                    "Q1 RU policies currently require a 20 MHz channel");
+    Ptr<HeConfiguration> heConfiguration = m_apMac->GetHeConfiguration();
+    NS_ASSERT(heConfiguration);
+    WifiTxVector txVector;
+    txVector.SetPreambleType(WIFI_PREAMBLE_HE_MU);
+    txVector.SetChannelWidth(m_allowedWidth);
+    txVector.SetGuardInterval(heConfiguration->GetGuardInterval());
+    txVector.SetBssColor(heConfiguration->m_bssColor);
+
+    const auto features = Q1RuOptimizer::BuildFeatures(states, heConfiguration->GetGuardInterval());
+    m_stateLatenciesUs.push_back(
+        std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - decisionStart)
+            .count());
+    Q1RuAction action;
+    if (m_dlSelectionPolicy == 2)
+    {
+        action = Q1RuOptimizer::Optimize(states,
+                                         txVector,
+                                         m_apMac->GetWifiPhy(m_linkId)->GetPhyBand(),
+                                         std::min<std::size_t>(m_nStations, 9),
+                                         GetPpduMaxTime(WIFI_PREAMBLE_HE_MU),
+                                         m_oracleExchangeOverhead,
+                                         m_oracleDelayWeight,
+                                         m_oracleDelayScale);
+        WriteTrainingSample(features, states, action);
+    }
+    else
+    {
+        const auto inferenceStart = std::chrono::steady_clock::now();
+        const auto logits = m_policyModel.PredictRuLogits(features);
+        m_inferenceLatenciesUs.push_back(
+            std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() -
+                                                       inferenceStart)
+                .count());
+        NS_ABORT_MSG_IF(logits.size() != Q1RuOptimizer::N_STATIONS *
+                                             Q1RuOptimizer::N_RU_CLASSES,
+                        "Q1 RU policy inference failed");
+        const auto projectionStart = std::chrono::steady_clock::now();
+        action = Q1RuOptimizer::Decode(states, logits, std::min<std::size_t>(m_nStations, 9));
+        m_projectionLatenciesUs.push_back(
+            std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() -
+                                                       projectionStart)
+                .count());
+        if (action.assignments.empty())
+        {
+            ++m_learnedFallbackCount;
+        }
+    }
+
+    for (std::size_t order = 0; order < action.assignments.size(); ++order)
+    {
+        const auto& assignment = action.assignments[order];
+        const auto aid = states.at(assignment.stationIndex).aid;
+        m_selectedRus.emplace(aid, assignment.ru);
+        scores[aid] = static_cast<double>(action.assignments.size() - order);
+    }
+    m_selectedRuAllocation = action.ruAllocation;
+    m_hasRuAction = !action.assignments.empty();
+    NS_LOG_INFO("Q1 RU action allocation=" << +m_selectedRuAllocation
+                                            << " users=" << action.assignments.size()
+                                            << " objective=" << action.objective);
+    for (const auto& assignment : action.assignments)
+    {
+        NS_LOG_INFO("  AID=" << states.at(assignment.stationIndex).aid
+                              << " RU=" << assignment.ru);
+    }
+    stationList.sort([&scores](const MasterInfo& lhs, const MasterInfo& rhs) {
+        const auto lhsScore = scores.contains(lhs.aid) ? scores.at(lhs.aid) : 0.0;
+        const auto rhsScore = scores.contains(rhs.aid) ? scores.at(rhs.aid) : 0.0;
+        return lhsScore > rhsScore;
+    });
+    m_decisionLatenciesUs.push_back(
+        std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - decisionStart)
+            .count());
+    return std::max<std::size_t>(1, action.assignments.size());
+}
+
+void
+RrMultiUserScheduler::WriteTrainingSample(const std::vector<float>& features,
+                                          const std::vector<Q1RuStationState>& states,
+                                          const Q1RuAction& action)
+{
+    if (!m_trainingStream || (m_trainingOpportunity++ % m_trainingSampleStride) != 0 ||
+        action.assignments.empty())
+    {
+        return;
+    }
+    std::vector<uint8_t> labels(Q1RuOptimizer::N_STATIONS, 0);
+    for (const auto& assignment : action.assignments)
+    {
+        labels.at(assignment.stationIndex) = Q1RuOptimizer::GetRuClass(assignment.ru.GetRuType());
+    }
+    m_trainingStream << std::setprecision(9) << "{\"schema\":\"q1-ns3-ru-v4\",\"time_s\":"
+                     << Simulator::Now().ToDouble(Time::S) << ",\"delay_weight\":"
+                     << m_oracleDelayWeight << ",\"delay_scale_ms\":"
+                     << m_oracleDelayScale.ToDouble(Time::MS) << ",\"horizon_us\":"
+                     << GetPpduMaxTime(WIFI_PREAMBLE_HE_MU).ToDouble(Time::US)
+                     << ",\"exchange_overhead_us\":"
+                     << m_oracleExchangeOverhead.ToDouble(Time::US)
+                     << ",\"objective\":" << action.objective
+                     << ",\"ppdu_us\":" << action.ppduDuration.ToDouble(Time::US)
+                     << ",\"allocation\":" << +action.ruAllocation << ",\"aids\":[";
+    for (std::size_t index = 0; index < Q1RuOptimizer::N_STATIONS; ++index)
+    {
+        if (index)
+        {
+            m_trainingStream << ',';
+        }
+        m_trainingStream << (index < states.size() ? states[index].aid : 0);
+    }
+    m_trainingStream << "],\"states\":[";
+    for (std::size_t station = 0; station < states.size(); ++station)
+    {
+        if (station)
+        {
+            m_trainingStream << ',';
+        }
+        const auto& state = states[station];
+        m_trainingStream << "{\"aid\":" << state.aid << ",\"mcs\":" << +state.mcs
+                         << ",\"nss\":" << +state.nss << ",\"queue_packets\":"
+                         << state.queuePackets << ",\"queue_bytes\":" << state.queueBytes
+                         << ",\"max_ampdu_bytes\":" << state.maxAmpduBytes
+                         << ",\"prefix\":[";
+        for (std::size_t packet = 0; packet < state.queue.size(); ++packet)
+        {
+            if (packet)
+            {
+                m_trainingStream << ',';
+            }
+            const auto& item = state.queue[packet];
+            m_trainingStream << "[" << item.payloadBytes << ',' << item.mpduBytes << ','
+                             << item.ageMs << ']';
+        }
+        m_trainingStream << "]}";
+    }
+    m_trainingStream << "],\"assignments\":[";
+    for (std::size_t index = 0; index < action.assignments.size(); ++index)
+    {
+        if (index)
+        {
+            m_trainingStream << ',';
+        }
+        const auto& assignment = action.assignments[index];
+        m_trainingStream << "{\"station\":" << assignment.stationIndex << ",\"ru_class\":"
+                         << +Q1RuOptimizer::GetRuClass(assignment.ru.GetRuType())
+                         << ",\"ru_index\":" << assignment.ru.GetIndex()
+                         << ",\"packets\":" << assignment.packetCount
+                         << ",\"payload_bytes\":" << assignment.payloadBytes << '}';
+    }
+    m_trainingStream << "],\"features\":[";
+    for (std::size_t index = 0; index < features.size(); ++index)
+    {
+        if (index)
+        {
+            m_trainingStream << ',';
+        }
+        m_trainingStream << features[index];
+    }
+    m_trainingStream << "],\"ru_classes\":[";
+    for (std::size_t index = 0; index < labels.size(); ++index)
+    {
+        if (index)
+        {
+            m_trainingStream << ',';
+        }
+        m_trainingStream << +labels[index];
+    }
+    m_trainingStream << "]}\n";
+}
